---
import "./styles/global.css"

import type { Props as SeoProps } from "astro-seo";
import Footer from ".//section/Footer.astro";
import Header from "./section/Header.astro";
import { SEO } from "astro-seo"; 

const { seo } = Astro.props as { seo: SeoProps} ;
---

<html lang="ko" transition:name="root" transition:animate="none">
	<head>
		<SEO {...seo} charset="utf-8" />
	</head>
	<Header />
	<body>
		<main>
			<div class="modal-blur-overlay">
				<slot />
			</div>
		</main>
	</body>

	<Footer />
	<script>
		import mermaid from "mermaid";
		
		document.addEventListener("DOMContentLoaded", () => {
			mermaid.initialize({
				theme: "dark",
			});
		});

		document.addEventListener("astro:after-swap", () => {
			mermaid.run();
		});
	</script>
</html>
