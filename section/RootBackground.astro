---

---

<div
	class:list={[
		"min-h-screen relative overflow-y-hidden",
		"bg-linear-to-br",
		"dark:from-black dark:via-gray-900 dark:to-slate-900",
		"from-white via-gray-100 to-slate-100",
	]}
>
	<div id="ufo" class="absolute inset-0 overflow-hidden pointer-events-none">
		<div
			class="absolute top-0 left-1/4 w-96 h-96 bg-balck/5 dark:bg-gray-500/15 rounded-full blur-3xl"
		>
		</div>
		<div
			class="absolute bottom-0 right-1/4 w-96 h-96 bg-gray-500/10 dark:bg-gray-500/15 rounded-full blur-3xl"
		>
		</div>
		<div
			class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-slate-400/10 rounded-full blur-3xl"
		>
		</div>
	</div>
	<slot />
</div>

<script>
	import { animate, AnimationOptions, DOMKeyframesDefinition, inView } from "motion";
	const ufoContainer = document.querySelector("#ufo")!;
	for (let i = 0; i < ufoContainer.children.length; i++) {
		const childrenEl = ufoContainer.children.item(i);
        if(!childrenEl) { continue }

        let keyFrame: DOMKeyframesDefinition = { scale: [1, 1.3, 1]}
        let option: AnimationOptions = {repeat: Infinity }
		switch (i) {
			case 0:
                keyFrame = { ...keyFrame, x: [0, 50, 0], y: [0, 30, 0]}
                option = { ...option, duration: 20, ease: "easeInOut"}
				break;
			case 1:
                keyFrame = { ...keyFrame, x: [0, -30, 0], y: [0, -50, 0]}
                option = { ...option, duration: 25, ease: "easeInOut"}
				break;
			case 2:
                option = { ...option, duration: 30, ease: "linear"}
				break;
		}

        inView(childrenEl, (el) => {
            animate(el,keyFrame,option)
        })
	}
</script>
